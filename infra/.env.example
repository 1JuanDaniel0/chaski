# Copia este archivo a infra/.env (está en .gitignore) y rellénalo en la VM.

# Etiqueta de la imagen de señalización (el SHA del commit; lo pone deploy.sh)
SIGNAL_TAG=latest

# Secreto compartido entre señalización y coturn. Genera uno con: openssl rand -hex 32
TURN_SECRET=cambia-esto

# IP pública y privada de la VM (NAT 1:1 de Oracle): IPpublica/IPprivada
TURN_EXTERNAL_IP=203.0.113.10/10.0.0.5

# Tope de gasto del relevo: GB que pueden salir de la VM al mes antes de apagar coturn (ver scripts/turn-budget.sh)
TURN_MONTHLY_GB=50
